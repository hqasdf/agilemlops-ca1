# Example settings for the CA1 pipeline and loaders. Values are placeholders, not real servers.
# Copy to a file outside version control (e.g. .env), fill it in, then either:
#   export CA1_CONFIG_FILE=/path/to/.env      or      python pbi10_pipeline.py --config /path/to/.env ...
# A variable set in the environment overrides the same name in the file.
# .env and *.pem are ignored by git. Never commit real passwords, hosts or keys.

# --- Database (AWS RDS MySQL, PBI 04) ---
CA1_DB_HOST=your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
CA1_DB_PORT=3306
CA1_DB_NAME=amlops_ca1
CA1_DB_USER=pipeline_loader
CA1_DB_PASSWORD=replace-with-your-password
# Path to the AWS RDS CA bundle (certificate and hostname are always verified)
CA1_DB_SSL_CA=/path/to/global-bundle.pem

# --- Shared MLflow service (PBI 05 / 12) ---
MLFLOW_TRACKING_URI=https://your-mlflow.example.com

# --- Optional (defaults shown) ---
CA1_DB_CONNECT_TIMEOUT_SECONDS=10
CA1_DOWNLOAD_TIMEOUT_SECONDS=30
CA1_DOWNLOAD_MAX_BYTES=250000000
